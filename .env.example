# Comfy API key from https://platform.comfy.org/profile/api-keys (pay per use, no subscription)
COMFY_API_KEY=
# Any ComfyUI server. Use https://cloud.comfy.org to run on Comfy Cloud instead.
COMFY_URL=https://cloud.comfy.org
# open = Qwen-Image-Edit + LTX-2.5 open weights · partner = FLUX 3 + LTX-2.5 partner nodes
FORKFIELD_ENGINE=open
PORT=8190
# Max clips per day (0 = no limit). Useful for a public demo.
DAILY_LIMIT=0
